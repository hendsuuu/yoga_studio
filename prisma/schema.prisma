generator client {
    provider = "prisma-client"
    output   = "./generated/client"
}

datasource db {
    provider = "postgresql"
}

enum Role {
    ADMIN
    MEMBER
    COACH
}

model User {
    id                  String       @id @default(cuid())
    fullName            String
    email               String       @unique
    phone               String       @default("")
    passwordHash        String
    role                Role         @default(MEMBER)
    isActive            Boolean      @default(true)
    specialAccess       Boolean      @default(false)
    membershipExpiresAt DateTime?
    photo               String?
    certificate         String?
    specialty           String?
    createdAt           DateTime     @default(now())
    updatedAt           DateTime     @updatedAt
    aiUsageLogs         AiUsageLog[]

    @@map("users")
}

model Schedule {
    id          String   @id @default(cuid())
    title       String
    date        DateTime
    timeRange   String
    coach       String
    coachPhoto  String?
    certificate String?
    tools       String?
    meetingId   String?
    meetingPass String?
    zoomUrl     String?
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@map("schedules")
}

model Recording {
    id          String   @id @default(cuid())
    title       String
    date        DateTime
    coach       String
    duration    String?
    url         String
    isPublished Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@map("recordings")
}

model Announcement {
    id        String    @id @default(cuid())
    message   String
    isActive  Boolean   @default(true)
    startAt   DateTime?
    endAt     DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    @@map("announcements")
}

model AppConfig {
    id        String   @id @default(cuid())
    key       String   @unique
    value     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("app_configs")
}

model MusicTrack {
    id        String   @id @default(cuid())
    title     String
    artist    String
    duration  String   @default("0:00")
    url       String
    category  String   @default("relaxation")
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("music_tracks")
}

model AiUsageLog {
    id        String   @id @default(cuid())
    memberId  String
    feature   String
    prompt    String?
    createdAt DateTime @default(now())
    member    User     @relation(fields: [memberId], references: [id], onDelete: Cascade)

    @@map("ai_usage_logs")
}
